<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.web.WebView?>

<GridPane xmlns="http://javafx.com" 
          xmlns:fx="http://microsoft.com" 
          fx:controller="ru.miet.activitycontroller.ui.MapController">
    
    <columnConstraints>
        <ColumnConstraints percentWidth="75.0" hgrow="ALWAYS" />
        <ColumnConstraints percentWidth="25.0" hgrow="NEVER" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
    </rowConstraints>

    <children>

        <WebView fx:id="mapWebView" 
                 GridPane.columnIndex="0" 
                 GridPane.rowIndex="0" />

        <VBox spacing="15" 
              style="-fx-background-color: #2c3e50; -fx-padding: 20;" 
              GridPane.columnIndex="1" 
              GridPane.rowIndex="0">
              
            <Label text="МОНИТОРИНГ" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <Label text="тут будут сервисы...." style="-fx-text-fill: #bdc3c7;" />
        </VBox>

    </children>
</GridPane>