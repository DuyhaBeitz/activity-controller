<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<GridPane xmlns="http://javafx.com" 
          xmlns:fx="http://javafx.com" 
          fx:controller="ru.miet.activitycontroller.ui.MapController">
    
    <columnConstraints>
        <ColumnConstraints percentWidth="75.0" hgrow="ALWAYS" />
        <ColumnConstraints percentWidth="25.0" hgrow="NEVER" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
    </rowConstraints>

    <children>

        <WebView fx:id="mapWebView" 
                 GridPane.columnIndex="0" 
                 GridPane.rowIndex="0" />

        <VBox fx:id="sidePanel"
              spacing="15" 
              styleClass="side-panel"
              GridPane.columnIndex="1" 
              GridPane.rowIndex="0">
              
            <Label fx:id="mainLabel" text="МОНИТОРИНГ" styleClass="title-large"/>
            
            <ScrollPane fx:id="serversScrollPane"
                        fitToWidth="true" 
                        VBox.vgrow="ALWAYS"
                        styleClass="transparent-scroll">
                <content>
                    <VBox fx:id="serversContainer"
                          spacing="10"
                          styleClass="side-panel" />
                </content>
            </ScrollPane>

            <VBox VBox.vgrow="ALWAYS"
                  alignment="BOTTOM_CENTER"
                  spacing="10">
                <Button
                    fx:id = "addServiceButton"
                    text="Добавить сервис"
                    onAction="#onAddServiceButton"
                    maxWidth="1.7976931348623157E308"
                    styleClass="btn-primary" />
                
                <Button
                    fx:id = "openSettingsButton"
                    text="Настройки"
                    onAction="#onOpenSettingsButton"
                    maxWidth="1.7976931348623157E308"
                    styleClass="btn-secondary" />

                <Button
                    fx:id="showAllServersButton"
                    text="Все серверы →" 
                    onAction="#onShowAllServersClick"
                    maxWidth="1.7976931348623157E308"
                    styleClass="btn-primary" />
            </VBox>
        </VBox>

    </children>
</GridPane>