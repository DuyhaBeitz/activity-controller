<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            fitToHeight="true"
            styleClass="transparent-scroll, app-bg"
            vbarPolicy="NEVER"
            xmlns="http://javafx.com" 
            xmlns:fx="http://javafx.com"
            fx:controller="ru.miet.activitycontroller.ui.SettingsController">

    <content>
        <VBox spacing="15.0" styleClass="app-bg">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
            </padding>
            
            <children>
                <Label text="Настройки"
                       wrapText="true"
                       alignment="CENTER"
                       maxWidth="1.7976931348623157E308"
                       styleClass="title-large" />

                <HBox fx:id="switchThemeBox"
                      spacing="15.0"
                      alignment="CENTER_LEFT"
                      maxWidth="1.7976931348623157E308">
                    <children>
                        <Label fx:id="switchThemeLabel"
                               text="Тёмная тема:"
                               wrapText="true"
                               maxWidth="1.7976931348623157E308"
                               HBox.hgrow="ALWAYS"
                               styleClass="label-bold"/>
                        <ToggleButton fx:id="themeSwitch"
                                      text="ВЫКЛ"
                                      minWidth="-Infinity"
                                      onAction="#onThemeSwitchClick"/>
                    </children>
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="saveButton"
                        onAction="#onSaveSettingsClick"
                        text="Сохранить"
                        styleClass="btn-primary"
                        maxWidth="1.7976931348623157E308"/>
            </children>
        </VBox>
    </content>
</ScrollPane>