<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com" 
            xmlns:fx="http://javafx.com" 
            fx:controller="ru.miet.activitycontroller.ui.AllServersController"
            style="-fx-background-color: #f4f6f7;"
            fx:id="rootPane">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #232853;">
            <Button fx:id="backButton"
                    text="← На главную"/>
            
            <HBox HBox.hgrow="ALWAYS" />
            
            <Button fx:id="addButton"
                    text="Добавить сервис"/>
        </HBox>
    </top>

    <center>
        <HBox>
            <VBox prefWidth="320" minWidth="320" style="-fx-border-color: #dcdcdc; -fx-border-width: 0 1 0 0;">
                <Label 
                    text="Все серверы"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 15; -fx-text-fill: #232853;"/>
                <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: #f4f6f7; -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="serversContainer" spacing="10" style="-fx-padding: 10;"/>
                    </content>
                </ScrollPane>
            </VBox>

            <VBox 
                fx:id="detailsPanel"
                HBox.hgrow="ALWAYS"
                visible="false"
                managed="false" 
                style="-fx-background-color: white; -fx-padding: 20;"
                spacing="15">
                  
                <Label
                    fx:id="detailsTitle"
                    text="Сервер: ..."
                    style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1c1c1c;"/>
                <!-- <Label
                    fx:id="detailsStatus"
                    text="Статус: ..."
                    style="-fx-font-size: 16px; -fx-text-fill: #1c1c1c;"/>
                
                <VBox
                    fx:id="notesBox"
                    spacing="5"
                    visible="false"
                    managed="false">
                    <Label text="Заметки:" style="-fx-font-weight: bold; -fx-text-fill: #1c1c1c;"/>
                    <TextArea fx:id="detailsNotes" editable="false" wrapText="true" prefRowCount="5"
                              style="-fx-control-inner-background: #f4f6f7; -fx-border-color: #dcdcdc;"/>
                </VBox> -->
                
                <!-- Сюда потом можно добавить кнопки (Диагностика, Удалить) -->
            </VBox>
        </HBox>
    </center>
</BorderPane>