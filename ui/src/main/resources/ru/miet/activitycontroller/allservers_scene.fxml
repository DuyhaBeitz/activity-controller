<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com" 
            xmlns:fx="http://javafx.com" 
            fx:controller="ru.miet.activitycontroller.ui.AllServersController"
            styleClass="app-bg"
            fx:id="rootPane">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="top-bar">
            <Button fx:id="backButton" text="← На главную" styleClass="btn-back"/>
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="addButton" text="Добавить сервис" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.3" styleClass="clean-split-pane">
            <VBox minWidth="320" spacing="10" style="-fx-padding: 15;">
                <Label fx:id="mainLabel" text="Все серверы" styleClass="title-large"/>

                <TextField
                    fx:id="searchField"
                    promptText="Поиск по имени или адресу"
                    styleClass="styled-input"
                    maxWidth="1.7976931348623157E308" />
                
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <MenuButton fx:id="sortButton"
                                text="Сортировать"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                styleClass="filter-menu-btn">
                        <items>
                            <MenuItem fx:id="sortByStatusItem" text="По тяжести статуса" />
                            <MenuItem fx:id="sortByResponseItem" text="По времени ответа" />
                            <MenuItem fx:id="sortByNameItem" text="По имени" />
                            <MenuItem fx:id="sortByDateItem" text="По дате добавления" />
                            <MenuItem fx:id="sortSmartItem" text="Умная сортировка" />
                            <MenuItem fx:id="sortByStabilityItem" text="По стабильности" />
                        </items>
                    </MenuButton>

                    <Button fx:id="reverseSortButton"
                            text="▼"
                            minWidth="-Infinity"
                            styleClass="filter-menu-btn" />

                    <MenuButton fx:id="filterButton"
                                text="Выбрать тег"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                styleClass="filter-menu-btn">
                        <items>
                            <MenuItem text="Все" />
                        </items>
                    </MenuButton>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                    <content>
                        <VBox fx:id="serversContainer" spacing="10" />
                    </content>
                </ScrollPane>
            </VBox>

            <ScrollPane fitToWidth="true" 
                        visible="false" 
                        managed="false"
                        styleClass="transparent-scroll, card-panel"
                        fx:id="detailsScrollPane">
                <content>
                    <VBox fx:id="detailsPanel" styleClass="card-panel" style="-fx-padding: 20;" spacing="15">
                        <Label fx:id="detailsTitle" text="Сервер: ..." styleClass="title-large" />
                        <Label fx:id="detailsStatus" text="Текущий статус: " styleClass="label-regular" />

                        <!-- БЛОК ГРАФИКА АКТИВНОСТИ -->
                        <VBox fx:id="chartSection" spacing="12" styleClass="chart-container">
                            
                            <!-- Верхняя панель: выбор параметра и периода -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <ComboBox fx:id="metricComboBox"
                                        styleClass="styled-combo"
                                        minWidth="-Infinity" />

                                <ComboBox fx:id="yScaleComboBox"
                                        styleClass="styled-combo"
                                        minWidth="-Infinity" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button fx:id="liveModeBtn"
                                        text="● Live"
                                        minWidth="-Infinity"
                                        styleClass="live-btn" />

                                <HBox spacing="4" styleClass="range-bar">
                                    <ToggleButton fx:id="range15mBtn" text="15 мин" selected="true" styleClass="range-toggle" />
                                    <ToggleButton fx:id="range1hBtn" text="1 час" styleClass="range-toggle" />
                                    <ToggleButton fx:id="range24hBtn" text="24 часа" styleClass="range-toggle" />
                                    <ToggleButton fx:id="range7dBtn" text="7 дней" styleClass="range-toggle" />
                                </HBox>
                            </HBox>

                            <!-- Мини-карточки сводной статистики -->
                            <HBox spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="stat-card">
                                    <Label text="Среднее" styleClass="stat-title" />
                                    <Label fx:id="avgStatLabel" text="—" styleClass="stat-value" />
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="stat-card">
                                    <Label text="Минимум" styleClass="stat-title" />
                                    <Label fx:id="minStatLabel" text="—" styleClass="stat-value" />
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="stat-card">
                                    <Label text="Максимум" styleClass="stat-title" />
                                    <Label fx:id="maxStatLabel" text="—" styleClass="stat-value" />
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="stat-card">
                                    <Label text="Аптайм" styleClass="stat-title" />
                                    <Label fx:id="uptimeStatLabel" text="—" styleClass="stat-value" />
                                </VBox>
                            </HBox>

                            <!-- Сам график -->
                            <LineChart fx:id="activityChart"
                                    animated="false"
                                    createSymbols="false"
                                    legendVisible="false"
                                    styleClass="activity-chart">
                                <xAxis>
                                    <NumberAxis fx:id="xAxis" forceZeroInRange="false" autoRanging="true" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="yAxis" forceZeroInRange="true" autoRanging="true" />
                                </yAxis>
                            </LineChart>
                        </VBox>
                        
                        <VBox fx:id="notesBox" spacing="5" visible="false" managed="false">
                            <Label fx:id="notesLabel" text="Заметки:" styleClass="label-bold" />
                            <TextArea fx:id="detailsNotes" editable="false" wrapText="true" prefRowCount="5" styleClass="styled-textarea" />
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>