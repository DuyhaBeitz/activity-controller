<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com"
      xmlns:fx="http://javafx.com"
      fx:id="rootLayout"
      spacing="15.0"
      styleClass="card-panel">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <children>
        <Label fx:id="titleLabel" text="Сервис: " wrapText="true" maxWidth="1.7976931348623157E308" styleClass="title-medium"/>
        <Label fx:id="statusLabel" text="Текущий статус: " wrapText="true" maxWidth="1.7976931348623157E308" styleClass="label-regular"/>

        <HBox fx:id="switchBox" spacing="15.0" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" visible="false" managed="false">
            <children>
                <Label fx:id="switchLabel"
                       text="Включите, если админ взял сервис на контроль:"
                       wrapText="true"
                       maxWidth="1.7976931348623157E308"
                       HBox.hgrow="ALWAYS"
                       styleClass="label-regular"/>
                <ToggleButton fx:id="statusSwitch" text="ВЫКЛ" minWidth="-Infinity"/>
            </children>
        </HBox>

        <VBox fx:id="notesBox" spacing="5" visible="false" managed="false">
            <Label text="Заметки:" styleClass="label-bold" />
            <TextArea fx:id="notesArea" editable="false" wrapText="true" prefRowCount="5" styleClass="styled-textarea" />
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox fx:id="buttonsBox" spacing="15.0" alignment="CENTER" maxWidth="1.7976931348623157E308">
            <children>
                <Button fx:id="diagnosticButton" text="Провести диагностику" styleClass="btn-secondary" maxWidth="1.7976931348623157E308"/>
                <HBox spacing="20.0" alignment="CENTER" maxWidth="1.7976931348623157E308">
                    <children>
                        <Button fx:id="deleteButton" text="Удалить" styleClass="btn-danger" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="closeButton" text="Закрыть" styleClass="btn-primary" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>